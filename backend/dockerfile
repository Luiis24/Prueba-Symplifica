# --- ETAPA 1: Construir el Frontend (Vue.js / Vite) ---
FROM node:20-alpine AS frontend-build
WORKDIR /app-frontend
# Copia la carpeta del frontend (ajusta el nombre si se llama 'frontend' o similar)
COPY frontend/ ./ 
RUN npm install && npm run build

# --- ETAPA 2: Construir el Backend (Spring Boot con Java 25) ---
FROM eclipse-temurin:25-jdk-alpine AS build
WORKDIR /app
RUN apk add --no-cache maven

COPY pom.xml .
COPY src ./src

# Copiar los archivos estáticos ya compilados del frontend hacia la carpeta resources de Spring Boot
COPY --from=frontend-build /app-frontend/dist ./src/main/resources/static

# Compilar el JAR final que ya incluirá el frontend integrado
RUN mvn clean package -DskipTests

# --- ETAPA 3: Ejecución final ---
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]